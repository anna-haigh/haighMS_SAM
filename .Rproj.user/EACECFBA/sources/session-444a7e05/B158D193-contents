make_effect_plot <- function(x_var, x_label, group_var = NULL, facet_var = NULL, n = 100) {
  grid <- expand.grid(
    x_raw = seq(min(bigflur_pca[[x_var]], na.rm = TRUE),
                max(bigflur_pca[[x_var]], na.rm = TRUE), length.out = n),
    needle_age = levels(as.factor(bigflur_pca$needle_age)),
    tree_treatment = levels(as.factor(bigflur_pca$tree_treatment))
  )
  names(grid)[names(grid) == "x_raw"] <- paste0(x_var, "_raw")
  
  if (x_var == "max_airtemp_lag1") {
    grid$max_airtemp_lag1 <- to_scaled(grid$max_airtemp_lag1_raw, "max_airtemp_lag1")  # FIXED: scaled
  } else if (x_var %in% c("cum_vpd_hours_resid", "max_vpd_lag1_resid")) {
    grid[[x_var]] <- to_scaled_resid(grid[[paste0(x_var, "_raw")]], x_var)
  } else {
    grid[[x_var]] <- to_scaled(grid[[paste0(x_var, "_raw")]], x_var)
  }
  
  # Always ensure max_airtemp_lag1 exists in the grid -- held at its SCALED mean (0)
  # unless it's the variable actually being plotted
  if (x_var != "max_airtemp_lag1") {
    grid$max_airtemp_lag1 <- 0   # FIXED: scaled mean, not raw mean
  }
  
  other_vars <- setdiff(scale_vars_pca, c("max_airtemp_lag1", x_var))
  for (v in other_vars) grid[[v]] <- 0
  other_resid_vars <- setdiff(c("cum_vpd_hours_resid", "max_vpd_lag1_resid"), x_var)
  for (v in other_resid_vars) grid[[v]] <- 0
  
  grid$needle_age     <- factor(grid$needle_age, levels = levels(as.factor(bigflur_pca$needle_age)))
  grid$tree_treatment <- factor(grid$tree_treatment, levels = levels(as.factor(bigflur_pca$tree_treatment)))
  
  grid$pred <- predict(PSII_pca$final_model, newdata = grid, level = 0)
  
  p <- ggplot(grid, aes(x = .data[[paste0(x_var, "_raw")]], y = pred))
  
  if (!is.null(group_var)) {
    p <- p + aes(color = .data[[group_var]]) + geom_line(linewidth = 1)
  } else {
    p <- p + geom_line(linewidth = 1, color = "steelblue")
  }
  if (!is.null(facet_var)) {
    p <- p + facet_wrap(as.formula(paste("~", facet_var)))
  }
  
  p + labs(x = x_label, y = "Predicted Fv/Fm",
           title = paste("Effect of", x_label)) +
    scale_color_manual(values = c("new" = "goldenrod", "old" = "darkseagreen",
                                  "control" = "steelblue", "irrigated" = "firebrick")) +
    theme_bw() + theme(legend.position = "bottom")
}

