make_heatmap <- function(y_var, y_label, n = 60) {
  grid <- expand.grid(
    max_airtemp_lag1_raw = seq(min(bigflur$max_airtemp_lag1, na.rm = TRUE),
                               max(bigflur$max_airtemp_lag1, na.rm = TRUE), length.out = n),
    y_raw = seq(min(bigflur[[y_var]], na.rm = TRUE),
                max(bigflur[[y_var]], na.rm = TRUE), length.out = n),
    needle_age = unique(bigflur$needle_age),
    tree_treatment = unique(bigflur$tree_treatment)
  )
  names(grid)[names(grid) == "y_raw"] <- paste0(y_var, "_raw")
  
  grid$max_airtemp_lag1 <- grid$max_airtemp_lag1_raw
  
  grid[[y_var]] <- to_scaled(grid[[paste0(y_var, "_raw")]], y_var)
  
  other_vars <- setdiff(scale_vars, c("max_airtemp_lag1", y_var))
  for (v in other_vars) grid[[v]] <- 0
  
  grid$needle_age     <- factor(grid$needle_age, levels = levels(as.factor(bigflur$needle_age)))
  grid$tree_treatment <- factor(grid$tree_treatment, levels = levels(as.factor(bigflur$tree_treatment)))
  
  grid$pred <- predict(PSIImod, newdata = grid, level = 0)
  
  ggplot(grid, aes(x = max_airtemp_lag1_raw, y = .data[[paste0(y_var, "_raw")]])) +
    geom_raster(aes(fill = pred), interpolate = TRUE) +
    geom_contour(aes(z = pred), breaks = seq(0, 1, by = 0.1),
                 color = "white", linewidth = 0.3, alpha = 0.6) +
    scale_fill_viridis_c(name = "Predicted\nFv/Fm", option = "plasma") +
    facet_grid(tree_treatment ~ needle_age) +
    labs(x = "Max Air Temp (lag1, °C)", y = y_label,
         title = paste("max_airtemp_lag1 ×", y_var)) +
    theme_bw()
}

