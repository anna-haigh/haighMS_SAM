vpd_model  <- lm(max_vpd_primet_trmt ~ max_airtemp_primet_trmt, data = tree_cleaned2)

make_heatmap_simple <- function(y_var, y_label, n = 60) {
  grid <- expand.grid(
    max_airtemp_primet_trmt = seq(min(tree_cleaned2$max_airtemp_primet_trmt, na.rm = TRUE),
                                  max(tree_cleaned2$max_airtemp_primet_trmt, na.rm = TRUE), length.out = n),
    y_raw = seq(min(tree_cleaned2[[y_var]], na.rm = TRUE),
                max(tree_cleaned2[[y_var]], na.rm = TRUE), length.out = n),
    needle_age = levels(as.factor(tree_cleaned2$needle_age)),
    tree_treatment = levels(as.factor(tree_cleaned2$tree_treatment))  # keep both levels IN the grid...
  )
  names(grid)[names(grid) == "y_raw"] <- paste0(y_var, "_raw")
  
  grid[[y_var]] <- to_scaledresil(grid[[paste0(y_var, "_raw")]], y_var)
  
  if (y_var != "lag2_max_airtemp_M0") grid$lag2_max_airtemp_M0 <- to_scaledresil(predict(lag2_model, newdata = grid), "lag2_max_airtemp_M0")
  if (y_var != "lag3_max_airtemp_M0") grid$lag3_max_airtemp_M0 <- to_scaledresil(predict(lag3_model, newdata = grid), "lag3_max_airtemp_M0")
  if (y_var != "max_vpd_primet_trmt") grid$max_vpd_primet_trmt <- to_scaledresil(predict(vpd_model, newdata = grid), "max_vpd_primet_trmt")
  
  other_vars <- setdiff(scale_varsresil,
                        c("max_airtemp_primet_trmt", y_var,
                          "lag2_max_airtemp_M0", "lag3_max_airtemp_M0", "max_vpd_primet_trmt"))
  for (v in other_vars) grid[[v]] <- 0
  
  grid$needle_age     <- factor(grid$needle_age, levels = levels(as.factor(tree_cleaned2$needle_age)))
  grid$tree_treatment <- factor(grid$tree_treatment, levels = levels(as.factor(tree_cleaned2$tree_treatment)))
  
  grid$pred <- predict(resis_mod, newdata = grid, level = 0)
  
  # ...then average OUT tree_treatment here, right before plotting
  grid_avg <- grid %>%
    group_by(across(all_of(c("max_airtemp_primet_trmt", paste0(y_var, "_raw"))))) %>%
    summarise(pred = mean(pred, na.rm = TRUE), .groups = "drop")
  
  ggplot(grid_avg, aes(x = max_airtemp_primet_trmt, y = .data[[paste0(y_var, "_raw")]])) +
    geom_raster(aes(fill = pred), interpolate = TRUE) +
    geom_contour(aes(z = pred), color = "white", linewidth = 0.3, alpha = 0.6) +
    scale_fill_viridis_c(name = "Predicted Resistance", option = "plasma") +
    labs(x = "Max Air Temp Treatment (°C)", y = y_label,
         title = paste("max_airtemp_primet_trmt ×", y_var)) +
    theme_bw()
}

