boost_if_heated <- function(value, date, heat_treatment, window_start, window_end) {
  in_window <- heat_treatment == "heated" &
    !is.na(window_start) & !is.na(window_end) &
    date >= window_start & date < window_end
  value + if_else(in_window, 2, 0)
}

