  mutate(
    lookup_date   = measurement_date - 1,  
    baseline_date = window_start - 1,      
    ceiling_date  = window_end - 1          
  ) %>%
  left_join(daily_env, by = c("lookup_date" = "Date_only")) %>%
  left_join(
    daily_env %>% select(Date_only, extra_baseline = cum_extra_35to33_daily),
    by = c("baseline_date" = "Date_only")
  ) %>%
  left_join(
    daily_env %>% select(Date_only, extra_ceiling = cum_extra_35to33_daily),
    by = c("ceiling_date" = "Date_only")
  ) %>%
  mutate(
    extra_baseline = replace_na(extra_baseline, 0),  
    window_boost = case_when(
      heat_treatment != "heated" | is.na(window_start)   ~ 0,   
      lookup_date < window_start                          ~ 0,   
      lookup_date < window_end                             ~ pmax(0, cum_extra_35to33_daily - extra_baseline),
      TRUE                                                  ~ pmax(0, extra_ceiling - extra_baseline)  
    ),
    cum_stress_hours_above_temp = cum_hours_control_daily + window_boost
  ) %>%
  select(-lookup_date, -baseline_date, -ceiling_date, -window_start, -window_end,
         -cum_hours_control_daily, -cum_extra_35to33_daily,
         -extra_baseline, -extra_ceiling, -window_boost)

