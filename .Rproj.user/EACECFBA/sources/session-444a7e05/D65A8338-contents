env_tracks <- env_clean %>%
  arrange(Date_time) %>%
  mutate(
    interval_hours_control = if_else(
      !is.na(AIRTEMP_MEAN_150_0_04) & AIRTEMP_MEAN_150_0_04 >= 35, 5/60, 0
    ),
    cum_hours_control = cumsum(interval_hours_control),
    
    interval_hours_33 = if_else(
      !is.na(AIRTEMP_MEAN_150_0_04) & AIRTEMP_MEAN_150_0_04 >= 33, 5/60, 0
    ),
    extra_hours_35to33 = interval_hours_33 - interval_hours_control,
    cum_extra_35to33   = cumsum(extra_hours_35to33)
  ) %>%
  mutate(
    interval_vpd_hours = if_else(
      !is.na(vpd_kpa) & vpd_kpa >=3, 5/60, 0
    ),
    cum_vpd_hours = cumsum(interval_vpd_hours)
  )

daily_env <- env_tracks %>%
  group_by(Date_only) %>%
  summarise(
    cum_hours_control_daily = max(cum_hours_control),
    cum_extra_35to33_daily  = max(cum_extra_35to33),
    cum_vpd_hours = max(cum_vpd_hours),
    .groups = "drop"
  )

