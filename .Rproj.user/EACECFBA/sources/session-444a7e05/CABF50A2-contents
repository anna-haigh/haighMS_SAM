head(glu3)

## Save slope and intercept parameters for each plate
p1eq<-lm(od_invertase ~ glucose_conc, data=glu1)
p1eq
p1int<-0.01449
p1slope<-1.15462

p1eq2<-lm(od_amg ~ glucose_conc, data=glu1)
p1eq2
p1int2<-(-0.001143)
p1slope2<-(1.2727)

p2eq<-lm(od_sugar_ghk ~ glucose_conc, data=glu2)
p2int<-0.0678
p2slope<-1.3255

p2eq2<-lm(od_amg ~ glucose_conc, data=glu2)
p2eq2
p2int2<-0.02691
p2slope2<-1.47691

p3eq<-lm(od_sugar_ghk ~ glucose_conc, data=glu3)
p3eq
p3int<-(-0.09473)
p3slope<-1.81333

p3eq2<-lm(od_amg ~ glucose_conc, data=glu3)
p3eq2
p3int2<-(-0.09262)
p3slope2<-1.69054

## Calculate dilution factor: df=(total well volume/well sample aliquot) * (H2O volume added to dry tissue / supernatant on sugar plate)
df1<-((220/20)*(1600/120))
df2<-((140/20)*(1000/120)*2) # Used 120uL ghk for plates 2 and 3
df21<-((220/20)*(1000/120)*2) 

## Sugar calculations
nsc1<- nsc1 %>%
  mutate(glu_fru_well=(od_sugar_ghk - p1int)/p1slope) %>%
  mutate(glu_fru_ex = glu_fru_well * df1) %>%
  mutate(mg_glu_fru = (glu_fru_ex * 1.6)/mass_mg) %>%
  mutate(sol_sug_well=(od_invertase - p1int)/p1slope) %>%
  mutate(sol_sug_ex = sol_sug_well * df1) %>%
  mutate(mg_sol_sug = ((sol_sug_ex *1.6)/mass_mg) + 2.389) %>%
  mutate(mg_sucrose = mg_sol_sug - mg_glu_fru) %>%
  mutate(nsc_well=(od_amg - p1int2)/p1slope2) %>%
  mutate(nsc_ex = nsc_well * df21) %>%
  mutate(mg_nsc = (nsc_ex * 1.6)/mass_mg) %>%
  mutate(mg_starch = mg_nsc - mg_sol_sug)

nsc2<- nsc2 %>%
  mutate(glu_fru_well=(od_sugar_ghk - p2int)/p2slope) %>%
  mutate(glu_fru_ex = glu_fru_well * df1) %>%
  mutate(mg_glu_fru = (glu_fru_ex * 1.6)/mass_mg) %>%
  mutate(sol_sug_well=(od_invertase - p2int)/p2slope) %>%
  mutate(sol_sug_ex = sol_sug_well * df1) %>%
  mutate(mg_sol_sug = ((sol_sug_ex *1.6)/mass_mg) + 0.9049) %>%
  mutate(mg_sucrose = (mg_sol_sug - mg_glu_fru) + 1) %>%
  mutate(nsc_well=(od_amg - p2int2)/p2slope2) %>%
  mutate(nsc_ex = nsc_well * df2) %>%
  mutate(mg_nsc = (nsc_ex * 1.6)/mass_mg) %>%
  mutate(mg_starch = mg_nsc - mg_sol_sug)

nsc3<- nsc3 %>%
  mutate(glu_fru_well=(od_sugar_ghk - p3int)/p3slope) %>%
  mutate(glu_fru_ex = glu_fru_well * df1) %>%
  mutate(mg_glu_fru = (glu_fru_ex * 1.6)/mass_mg) %>%
  mutate(sol_sug_well=(od_invertase - p3int)/p3slope) %>%
  mutate(sol_sug_ex = sol_sug_well * df1) %>%
  mutate(mg_sol_sug = (sol_sug_ex *1.6)/mass_mg) %>%
  mutate(mg_sucrose = mg_sol_sug - mg_glu_fru + 1) %>%
  mutate(nsc_well=(od_amg - p3int2)/p3slope2) %>%
  mutate(nsc_ex = nsc_well * df2) %>%
  mutate(mg_nsc = (nsc_ex * 1.6)/mass_mg) %>%
  mutate(mg_starch = mg_nsc - mg_sol_sug)


