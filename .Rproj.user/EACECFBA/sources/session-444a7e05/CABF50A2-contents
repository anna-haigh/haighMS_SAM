glu1<-filter(glu, Plate=="1")
glu2<-filter(glu, Plate=="2")
glu3<-filter(glu, Plate=="3")


## Check for linearity in serial dilutions
plot(glu1$glucose_conc, glu1$od_invertase)
plot(glu2$glucose_conc, glu2$od_sugar_ghk)
plot(glu3$glucose_conc, glu3$od_sugar_ghk)

## Remove weird value
head(glu3)
