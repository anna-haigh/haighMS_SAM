## Correct absorbency measurements using blanks and water plates
nsc<- nsc %>%
  mutate(sugar_ghk_corr=sugar_ghk_75 - sugar_ghk_blank) %>%
  mutate(sugar_h2o_corr=sugar_h2o_75 - sugar_h2o_blank) %>%
  mutate(invertase_ghk_corr = invertase_ghk_75 - invertase_ghk_blank) %>%
  mutate(invertase_h2o_corr = invertase_h2o_75 - invertase_h2o_blank) %>%
  mutate(amg_ghk_corr = amg_ghk_45 - amg_ghk_blank) %>%
  mutate(amg_h2o_corr = amg_h2o_45 - amg_h2o_blank) %>%
  mutate(od_sugar_ghk = sugar_ghk_corr - sugar_h2o_corr) %>%
  mutate(od_invertase = invertase_ghk_corr - invertase_h2o_corr) %>%
  mutate(od_amg = amg_ghk_corr - amg_h2o_corr)

glu <- glu %>%
  mutate(sugar_ghk_corr=sugar_ghk_75 - sugar_ghk_blank) %>%
  mutate(sugar_h2o_corr=sugar_h2o_75 - sugar_h2o_blank) %>%
