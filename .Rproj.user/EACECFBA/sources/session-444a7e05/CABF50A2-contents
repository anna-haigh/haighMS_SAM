## Summarize to means and 95% CI per group
head(nsc_long)
unique(nsc_long$sugar_fraction)

nsc_summary <- nsc_long %>%
  mutate(concentration = pmax(concentration, 0, na.rm = TRUE)) %>%
  mutate(measurement = factor(measurement,
                              levels = c("initial", "0", "1", "7", "14"),
                              labels = c("Initial", "0", "1", "7", "14"))) %>%
  group_by(needle_age, tree_treatment, sugar_fraction, measurement) %>%
  filter(! sugar_fraction == "Total NSC") %>%
  mutate(sugar_fraction = factor(sugar_fraction, levels = c("Total soluble sugars","Glucose + Fructose","Sucrose"))) %>%
  summarise(
    mean_conc = mean(concentration, na.rm = TRUE),
    n         = sum(!is.na(concentration)),
    se        = sd(concentration, na.rm = TRUE) / sqrt(n),
    ci95      = qt(0.975, df = n - 1) * se,
    .groups   = "drop"
  )

